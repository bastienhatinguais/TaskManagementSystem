@inherits LayoutComponentBase
@layout MainLayout
@using TaskManagementSystem.Client.Exceptions

<ErrorBoundary @ref="errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>

    <ErrorContent Context="ex">
        @if (ex is ApiException api && _showToast)
        {
            <div class="fixed top-4 right-4 z-[100] w-full max-w-md px-4">
                <div role="alert" aria-live="assertive"
                     class="relative rounded-xl border border-red-300 bg-red-50/95 p-4 text-red-900 shadow-xl backdrop-blur">

                    <button type="button" aria-label="Close"
                            class="absolute top-2 right-2 inline-flex h-7 w-7 items-center justify-center rounded-md text-red-700 hover:bg-red-100 focus:ring-2 focus:ring-red-400 focus:outline-none"
                            @onclick="Dismiss">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                  clip-rule="evenodd" />
                        </svg>
                    </button>

                    <div class="flex items-start gap-3 pr-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-red-600" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd"
                                  d="M8.257 3.099c.765-1.36 2.721-1.36 3.486 0l6.518 11.597c.75 1.336-.213 3.004-1.742 3.004H3.481c-1.53 0-2.492-1.668-1.742-3.004L8.257 3.1zM11 14a1 1 0 10-2 0 1 1 0 002 0zm-1-2a.75.75 0 01-.75-.75V7.25a.75.75 0 011.5 0v4a.75.75 0 01-.75.75z"
                                  clip-rule="evenodd" />
                        </svg>

                        <div class="min-w-0">
                            <p class="font-medium">
                                @(string.IsNullOrWhiteSpace(api.Problem?.Title) ? "Request failed" : api.Problem!.Title)
                            </p>

                            <p class="mt-1 text-sm leading-relaxed">
                                @(
                                    string.IsNullOrWhiteSpace(api.Problem?.Detail)
                                    ? (api.Message ?? "An error occurred.")
                                    : api.Problem!.Detail
                                    )
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
        @Body
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? errorBoundary;
    private bool _showToast = true;

    protected override void OnParametersSet() => errorBoundary?.Recover();

    private void Dismiss()
    {
        _showToast = false;
        errorBoundary?.Recover();
    }
}
